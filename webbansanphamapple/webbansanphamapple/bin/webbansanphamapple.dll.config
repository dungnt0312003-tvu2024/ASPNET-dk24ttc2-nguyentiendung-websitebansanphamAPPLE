<?xml version="1.0"?>
<configuration>

  <connectionStrings>
    <add name="AppleStoreDBConnectionString" connectionString="Data Source=DESKTOP-HSSVDLO;Initial Catalog=AppleStoreDB;Integrated Security=True;Encrypt=True;TrustServerCertificate=True"
      providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
  </system.web>
	<appSettings>
		<add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
	</appSettings>
</configuration>
